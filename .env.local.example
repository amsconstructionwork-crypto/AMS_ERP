# Get this from your Neon project dashboard (neon.tech) -> Connection Details
# Use the "pooled connection" string for serverless/Vercel deployments.
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Used to build absolute links for WhatsApp/Email sharing (the PDF link).
# Set this to your deployed URL once live, e.g. https://ams-billing.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Login Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password123"
JWT_SECRET="a-very-secure-jwt-secret-replace-in-production"
